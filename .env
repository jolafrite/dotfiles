#!/usr/bin/env bash
# Environment variables live in ~/.config/zsh/env_config.zsh (also sourced
# directly by zsh). This file is the single bash entry point: it is sourced
# by ~/.profile (and therefore by ~/.zshenv) and by the yadm bootstrap
# script, so it must remain POSIX-sh compatible.
#
# env_config.zsh guards its zsh-only history configuration behind a
# ZSH_VERSION check, so sourcing it from bash is safe.

if [ -r "$HOME/.config/zsh/env_config.zsh" ]; then
  . "$HOME/.config/zsh/env_config.zsh"
fi