# --- functions ---
httpDebug() { /usr/bin/curl "$@" -o /dev/null -w "dns: %{time_namelookup} connect: %{time_connect} pretransfer: %{time_pretransfer} starttransfer: %{time_starttransfer} total: %{time_total}\n"; }
httpHeaders() { /usr/bin/curl -I -L "$@"; }

gd() { [[ $(git status 2>/dev/null | tail -n1) != *"working directory clean"* ]] && echo "*"; }
gas() { git status; git add . -A; git commit -m "$1"; git push; }
gsa() { git stash save "$1" -a; git stash list; }
ydh() { yadm diff HEAD~"${1:-1}"; }
ycp() { if (($# == 0)); then yadm commit && yadm push; else yadm commit -m "$*" && yadm push; fi; }
feature_branch() {
  local main_branch="main"
  local prefix="feature"
  local today=$(date +%Y-%m-%d)
  local username=$(echo "$USER" | tr '[:upper:]' '[:lower:]')
  local additional_path=$(echo "$*" | tr ' ' '-')
  local index=1
  local new_branch
  local branch_path="${prefix}/${username}"
  [[ -n "$additional_path" ]] && branch_path="${branch_path}/${additional_path}"
  branch_path="${branch_path}/${today}"
  if [[ "$(git branch --show-current)" != "$main_branch" ]]; then
    echo "Switching to ${main_branch} and pulling latest changes..."
    git checkout $main_branch
    git pull
  fi
  while git rev-parse --verify --quiet "${branch_path}/${index}"; do
    index=$((index + 1))
  done
  new_branch="${branch_path}/${index}"
  echo "Creating and checking out ${new_branch}..."
  git checkout -b $new_branch
}
fb="feature_branch"
extract() {
  if [ -f "$1" ]; then
    case $(echo "$1" | tr "[A-Z]" "[a-z]") in
      *.tar.bz2) tar xjf "$1" ;;
      *.tar.gz) tar xzf "$1" ;;
      *.bz2) bunzip2 "$1" ;;
      *.rar) unrar e "$1" ;;
      *.gz) gunzip "$1" ;;
      *.tar) tar xf "$1" ;;
      *.tbz2) tar xjf "$1" ;;
      *.tgz) tar xzf "$1" ;;
      *.zip) unzip "$1" ;;
      *.Z) uncompress "$1" ;;
      *.7z) 7z x "$1" ;;
      *) echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}
groot() { root="$(git rev-parse --show-toplevel 2>/dev/null)"; if [ -n "$root" ]; then cd "$root"; else echo "Not in a git repository"; fi; }
cdi() { p="$(fd -t d -H | fzf)"; if [ -n "$p" ]; then cd "$p"; fi; }
fmv() { mv "$@" $(fd -t d -H | fzf); }
pkgrun() { name=$(jq .scripts package.json | sed '1d;$d' | fzf --height 40% | awk -F ': ' '{gsub(/"/, "", $1); print $1}'); if [[ -n $scripts ]]; then sudo apt run "$name"; fi; }
zv() { __zoxide "$1" && nvim .; }
psrm() { ps -o rss= -p "$1" | awk '{ hr=$1/1024; printf "%13.2f Mb\n",hr }' | tr -d ' '; }
psrml() { while true; do psrm "$1"; sleep 1; done; }
epoch() { if [[ "$OSTYPE" == "linux-gnu"* ]]; then date --date "@$1" "+%Y-%m-%dT%H:%M:%SZ"; else date -r "$1" '+%Y-%m-%dT%H:%M:%SZ'; fi; }
