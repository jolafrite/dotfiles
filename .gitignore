# ignore all files (allowlist: un-ignore only exact files below)
*

# allow every directory so git can descend; files still gated by `*`
!*/
!.git/

# skip descending into root-owned / heavy dirs
.kind/

# --- root files ---
!.gitignore
!.env
!.profile
!README.md
!dotfiles

# --- .config files (exact, no directory globbing) ---
!.config/.gitconfig
!.config/.ssh.config
!.config/starship.toml
!.config/supervisord.conf
!.config/atuin/config.toml
!.config/btop/btop.conf
!.config/dlv/config.yml
!.config/gh/config.yml
!.config/gh-dash/config.yml
!.config/ghostty/config
!.config/helm/repositories.lock
!.config/helm/repositories.yaml
!.config/jj/config.toml
!.config/k9s/aliases.yaml
!.config/k9s/config.yaml
!.config/kitty/neighboring_window.py
!.config/kitty/relative_resize.py
!.config/kitty/split_window.py
!.config/thefuck/settings.py
!.config/yadm/bootstrap
!.config/yadm/computer_bootstrap
!.config/yadm/linux_bootstrap
!.config/yadm/mac_bootstrap
!.config/yadm/utils
!.config/yadm/mac/set-default-apps
!.config/yadm/mac/set-macos-defaults
!.config/yadm/package_lists/Brewfile
!.config/yadm/package_lists/bash_packages.txt
!.config/yadm/package_lists/cargo_packages.txt
!.config/yadm/package_lists/gh_extension_packages.txt
!.config/yadm/package_lists/go_packages.txt
!.config/yadm/package_lists/linux_packages.txt
!.config/yadm/package_lists/node_packages.txt
!.config/yadm/package_lists/pipx_packages.txt
!.config/yadm/package_lists/python3_packages.txt
!.config/yadm/package_lists/ruby_packages.txt
!.config/zsh/.gitignore
!.config/zsh/.zshrc
!.config/zsh/aliases/aliases
!.config/zsh/aliases/aliases_common
!.config/zsh/aliases/aliases_linux
!.config/zsh/aliases/aliases_mac
!.config/zsh/aliases/remaps
!.config/zsh/aliases/suffix_aliases
!.config/zsh/aliases/suffix_aliases_linux
!.config/zsh/aliases/suffix_aliases_mac
!.config/zsh/cache_aliases.zsh
!.config/zsh/cd.zsh
!.config/zsh/completion.zsh
!.config/zsh/env_config.zsh
!.config/zsh/functions.zsh
!.config/zsh/functions_common.zsh
!.config/zsh/functions_linux.zsh
!.config/zsh/functions_mac.zsh
!.config/zsh/global_env.sh
!.config/zsh/lazy.zsh
!.config/zsh/linux.zsh
!.config/zsh/mac.zsh
!.config/zsh/progressive_enhancement.zsh
!.config/zsh/prompt.zsh
!.config/zsh/source_aliases.zsh
!.config/zsh/updates.zsh
!.config/zsh/updates_common.zsh
!.config/zsh/updates_linux.zsh
!.config/zsh/updates_mac.zsh

# --- .github / .hammerspoon / .local ---
!.github/dependabot.yml
!.hammerspoon/init.lua
!.local/scripts/cross-platform/editor
!.local/scripts/generic/datenow
!.local/scripts/generic/gitignore
!.local/scripts/generic/havecmd
!.local/scripts/generic/in-path
!.local/scripts/generic/is_machine
!.local/scripts/generic/ocr
!.local/scripts/generic/on_os
!.local/scripts/generic/super
!.local/scripts/generic/with-secrets

# --- docker-images ---
!docker-images/dsh/.gitignore
!docker-images/dsh/Dockerfile
!docker-images/dsh/entrypoint.sh

# --- never track these even though their dirs are visited ---
.config/zsh/personal_aliases
.config/zsh/secrets/
.config/zsh/.zcompcache/
.config/zsh/.zcompdump*
.config/zsh/.zsh_history
.config/zsh/.zsh_sessions/
.config/nvim-pack/
.config/tmux/plugins/
.config/jj/repos/
.config/fish/
.config/zed/
.config/clash*
docker-images/**/secrets/
docker-images/**/cloudflared/
docker-images/**/.dsh-context/
