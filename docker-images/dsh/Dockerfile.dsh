FROM node:26-slim AS dsh-builder

RUN npm install -g --no-audit --no-fund npm \
  && npm install -g --no-audit --no-fund pnpm \
    @deepseek-ai/dsh@next \
    @mnemon-dev/mnemon@latest

FROM node:26-slim

ENV DSH_HOME=/home/node/.dsh
ENV PNPM_HOME=/home/node/.dsh/.pnpm-global
ENV XDG_DATA_HOME=/home/node/.dsh/.data
ENV XDG_CACHE_HOME=/home/node/.dsh/.cache
ENV PATH=/home/node/.dsh/.pnpm-global:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    socat \
    tini \
    zsh \
    ssh \
    ca-certificates \
    sudo \
&& rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

COPY --from=dsh-builder /usr/local/ /usr/local/

RUN mkdir -p /home/node/workspaces /var/log/dsh /home/node/.ssh \
  && chown -R node:node /home/node/workspaces /var/log/dsh /home/node/.ssh \
  && chmod 700 /home/node/.ssh

COPY dsh-entrypoint.sh /usr/local/bin/dsh-entrypoint.sh
RUN chmod 755 /usr/local/bin/dsh-entrypoint.sh


RUN printf 'Host *\n  StrictHostKeyChecking accept-new\n' >> /etc/ssh/ssh_config

RUN echo "node ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/node \
 && chmod 0440 /etc/sudoers.d/node

USER node
WORKDIR /home/node
EXPOSE 3080

ENTRYPOINT ["tini", "--", "/usr/local/bin/dsh-entrypoint.sh"]

