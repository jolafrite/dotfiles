#!/usr/bin/env bash
set -euo pipefail

CONTAINER="dsh"

# ---------------------------------------------------------------------------
# subcommands
# ---------------------------------------------------------------------------

cmd_url() {
  local token
  token="$(podman logs "$CONTAINER" 2>/dev/null | grep -oE 'token=[A-Za-z0-9_-]+' | tail -1 | cut -d= -f2)"
  if [[ -z "$token" ]]; then
    echo "error: could not find token in container logs (is the container running?)" >&2
    exit 1
  fi
  local url="http://127.0.0.1:3080/?token=${token}"
  echo "$url"
  if [[ "${1:-}" != "--print-only" ]]; then
    open "$url" 2>/dev/null || true
  fi
}

cmd_exec() {
  if [[ $# -eq 0 ]]; then
    echo "usage: dsh-cli exec <args...>" >&2
    exit 1
  fi
  exec podman exec "$CONTAINER" "$@"
}

cmd_token() {
  podman logs "$CONTAINER" 2>/dev/null | grep -oE 'token=[A-Za-z0-9_-]+' | tail -1 | cut -d= -f2
}

cmd_remote() {
  ensure_cloudflare
  local token url
  token="$(cmd_token)"
  if [[ -z "$token" ]]; then
    echo "error: no token in container logs" >&2
    exit 1
  fi
  url="$(cloudflare_url)"
  if [[ -z "$url" ]]; then
    echo "error: could not get cloudflare URL" >&2
    exit 1
  fi
  echo "${url}/?token=${token}"
}

cmd_status() {
  podman inspect "$CONTAINER" --format \
    'Container: {{.Name}}\nStatus:  {{.State.Status}}\nHealth:  {{.State.Health.Status}}\nStarted: {{.State.StartedAt}}' 2>/dev/null
}

# ---------------------------------------------------------------------------
# routing
# ---------------------------------------------------------------------------

case "${1:-}" in
  url)
    shift
    cmd_url "$@"
    ;;
  exec)
    shift
    cmd_exec "$@"
    ;;
  token) cmd_token ;;
  remote) cmd_remote ;;
  status) cmd_status ;;
  *)
    echo "usage: dsh-cli {url|exec|token|remote|status}" >&2
    echo "  url            Print/open the GUI URL" >&2
    echo "  exec <args>    Run a command inside the dsh container" >&2
    echo "  token          Print the current access token" >&2
    echo "  remote         Get the remote GUI URL (cloudflare + token, for phone)" >&2
    echo "  status         Show container status + health" >&2
    exit 1
    ;;
esac